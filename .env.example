# Copy to .env and change every secret before a production deploy.
ENVIRONMENT=development

# Used by the API when you run uvicorn on the host.
# Docker Compose overrides this inside the api container so it can reach the mongo service.
MONGODB_URI=mongodb://auth:authpass@localhost:27017/auth?authSource=admin
MONGODB_DB=auth

# MongoDB container credentials. Keep these in sync with the user and password in MONGODB_URI.
MONGO_INITDB_ROOT_USERNAME=auth
MONGO_INITDB_ROOT_PASSWORD=authpass

# Use at least 32 random characters. This placeholder is rejected when ENVIRONMENT=production.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated. Production rejects a wildcard.
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Seeded only when the database has no admin account yet.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin123
ADMIN_EMAIL=admin@example.com

# Used by the production image as the uvicorn worker count.
WEB_CONCURRENCY=2
